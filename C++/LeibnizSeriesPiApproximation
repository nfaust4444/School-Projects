#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    cout << "Nathaniel Rodriguez" << endl;
    cout << "ECE 2305-002" << endl;
    cout << "Programming Project 3\n" << endl;
    cout << "Leibniz Series Approximation of Pi\n" << endl;
    cout << "N\t\t\tApproximate value\tActualValue\t\t% error" << endl;

    // Pi actual value
    double pi = 4 * atan(1);

    // Leibniz series approximation
    double k = 0;
    double perror;
    double api = 0.0;
    cout.setf(ios::fixed);
    cout.setf(ios::showpoint);
    cout.precision(15);
    for (k = 0; k <= 100; k++) {
        // Pi approximation
        api += pow(-1, k) * (4 / ((2 * k) + 1));

        // % error
        perror = abs(((api - pi) * 100) / pi);

        // Output
        cout << k << "\t" << api << "\t" << pi << "\t" << perror << endl;
    }

    return 0;
}
